datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id                 String  @id @default(uuid())
  brand              String
  model              String
  image              String?
  customerPrice      Float
  dealerPrice        Float
  deposit            Float
  dailyPayment       Float
  margin             Float
  referralCommission Float
  availability       String?
  specs              Json?
}

model Inquiry {
  id        String   @id @default(uuid())
  name      String?
  phone     String?
  message   String?
  productId String?
  status    String?
  createdAt DateTime @default(now())
}

model Order {
  id          String   @id @default(uuid())
  productId   String
  customerName String
  status      String
  total       Float?
  createdAt   DateTime @default(now())
}
